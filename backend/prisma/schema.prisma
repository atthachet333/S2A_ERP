// Prisma schema — Food ERP
// ฐานข้อมูลหลัก: MariaDB (Prisma provider: mysql)
// หลักการ: Decimal สำหรับเงิน/ปริมาณ, soft delete, audit fields, stock ผ่าน ledger เท่านั้น

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  // Migration/introspection ใช้ directUrl (บัญชี DDL ที่จำกัดสิทธิ์กับฐานข้อมูลนี้) เฉพาะตอนรัน migrate
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================
enum RoleName {
  SUPER_ADMIN
  MANAGER
  OPERATIONS
  ORDER_COORDINATOR
  CHEF
  COSTING_STAFF
  ADMIN
  EXECUTIVE
  PURCHASING
  WAREHOUSE
  PRODUCTION
  SALES
  VIEWER
}

enum ItemType {
  RAW_MATERIAL
  PACKAGING
  SEMI_FINISHED
  FINISHED_GOOD
  CONSUMABLE
  WASTE
}

enum StockMovementType {
  PURCHASE_RECEIPT
  PRODUCTION_ISSUE
  PRODUCTION_RETURN
  PRODUCTION_OUTPUT
  SALE
  SALES_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  WASTE
  EXPIRED
  STOCK_COUNT
}

enum ProductionStatus {
  DRAFT
  PLANNED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DocumentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  REVERSED
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  SENT_TO_PREP
  PICKING
  ISSUED
  READY
  DELIVERED
  CANCELLED
}

enum StockIssueStatus {
  DRAFT
  ISSUED
  CANCELLED
  REVERSED
}

enum NotificationSeverity {
  INFO
  ACTION_REQUIRED
  WARNING
  CRITICAL
}

// ============================================================
// AUTH & AUDIT
// ============================================================
model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  email              String    @unique
  passwordHash       String
  fullName           String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?

  // วงจรการสมัครใช้งานจากหน้าเว็บ (Issue 4) — null = บัญชีที่สร้างโดยผู้ดูแล/seed (ไม่ใช่คำขอสมัคร)
  registrationStatus String?   // PENDING | APPROVED | REJECTED
  approvedAt         DateTime?
  approvedById       String?
  rejectedAt         DateTime?
  rejectedById       String?
  rejectionReason    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userRoles               UserRole[]
  loginLogs               LoginLog[]
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  companyMemberships      CompanyMembership[]
  salesOrders             SalesOrder[]             @relation("SalesOrderCreator")
  stockIssues             StockIssue[]             @relation("StockIssueCreator")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@index([isActive])
  @@index([registrationStatus])
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  ip                String?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles          UserRole[]
  rolePermissions    RolePermission[]
  companyMemberships CompanyMembership[]

  @@map("roles")
}

model Company {
  id             String   @id @default(cuid())
  code           String   @unique
  nameTh         String
  nameEn         String?
  logoUrl        String?
  taxId          String?
  address        String?
  phone          String?
  email          String?
  website        String?
  /** PHASE 14 — LINE ID / LINE OA สำหรับติดต่อ (ไม่บังคับ) */
  lineId         String?
  authorizedName String?
  documentFooter String?
  signatureUrl   String?
  stampUrl       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships             CompanyMembership[]
  customers               Customer[]
  salesOrders             SalesOrder[]
  stockIssues             StockIssue[]
  inventoryLots           InventoryLot[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@index([isActive])
  @@map("companies")
}

model CompanyMembership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  roleId    String
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId, isActive])
  @@map("company_memberships")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // CREATE | UPDATE | DELETE | ...
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())
  companyId String?

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  username  String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("login_logs")
}

// ============================================================
// MASTER DATA — UNITS
// ============================================================
model Unit {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  itemsBase         Item[]             @relation("ItemBaseUnit")
  itemsPurchase     Item[]             @relation("ItemPurchaseUnit")
  conversionsFrom     UnitConversion[]   @relation("ConvFrom")
  conversionsTo       UnitConversion[]   @relation("ConvTo")
  recipeIngredients   RecipeIngredient[]
  recipeVersionsYield RecipeVersion[]    @relation("YieldUnit")
  extractionLines     GoodsReceiptExtractionLine[] @relation("ExtractionMatchedUnit")

  @@map("units")
}

model UnitConversion {
  id         String   @id @default(cuid())
  fromUnitId String
  toUnitId   String
  factor     Decimal  @db.Decimal(18, 6) // 1 fromUnit = factor toUnit
  fromUnit   Unit     @relation("ConvFrom", fields: [fromUnitId], references: [id])
  toUnit     Unit     @relation("ConvTo", fields: [toUnitId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([fromUnitId, toUnitId])
  @@map("unit_conversions")
}

// ============================================================
// MASTER DATA — CATEGORY / ITEM
// ============================================================
model Category {
  id        String    @id @default(cuid())
  companyId String
  code      String    @unique
  name      String
  type      ItemType?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  items Item[]

  @@map("categories")
}

model Item {
  id         String    @id @default(cuid())
  companyId  String
  code       String    @unique
  barcode    String?   @unique
  name       String
  type       ItemType
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  baseUnitId           String
  baseUnit             Unit    @relation("ItemBaseUnit", fields: [baseUnitId], references: [id])
  purchaseUnitId       String?
  purchaseUnit         Unit?   @relation("ItemPurchaseUnit", fields: [purchaseUnitId], references: [id])
  purchaseToBaseFactor Decimal @default(1) @db.Decimal(18, 6)

  avgCost      Decimal @default(0) @db.Decimal(18, 4)
  lastCost     Decimal @default(0) @db.Decimal(18, 4)
  reorderPoint Decimal @default(0) @db.Decimal(18, 4)
  minQty       Decimal @default(0) @db.Decimal(18, 4)

  isLotTracked    Boolean @default(false)
  isExpiryTracked Boolean @default(false)
  imageUrl        String?

  isActive    Boolean   @default(true)
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  priceHistory        ItemPriceHistory[]
  stockBalances       StockBalance[]
  stockLedgers        StockLedger[]
  inventoryLots       InventoryLot[]
  recipeIngredients   RecipeIngredient[]
  recipes             Recipe[]              @relation("RecipeProduct")
  productionOrders    ProductionOrder[]
  productionOutputs   ProductionOutput[]
  productionMaterials ProductionMaterial[]
  productionWastes    ProductionWaste[]
  goodsReceiptItems   GoodsReceiptItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  transferItems       StockTransferItem[]
  adjustmentItems     StockAdjustmentItem[]
  extractionLines     GoodsReceiptExtractionLine[] @relation("ExtractionMatchedItem")
  sellingPrices       SellingPrice[]

  @@index([type])
  @@index([categoryId])
  @@index([isActive])
  @@map("items")
}

model ItemPriceHistory {
  id          String   @id @default(cuid())
  companyId   String
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  price       Decimal  @db.Decimal(18, 4)
  source      String? // PURCHASE | MANUAL | ...
  note        String?
  createdAt   DateTime @default(now())
  createdById String?

  @@index([itemId, createdAt])
  @@map("item_price_history")
}

// ============================================================
// MASTER DATA — SUPPLIER / WAREHOUSE
// ============================================================
model Supplier {
  id        String    @id @default(cuid())
  companyId String
  code      String    @unique
  name      String
  taxId     String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  goodsReceipts GoodsReceipt[]
  purchaseOrders PurchaseOrder[]
  extractionMatches GoodsReceiptExtraction[] @relation("ExtractionMatchedSupplier")

  @@map("suppliers")
}

model Warehouse {
  id        String    @id @default(cuid())
  companyId String
  code      String    @unique
  name      String
  type      ItemType? // เช่น RAW_MATERIAL / FINISHED_GOOD (คลังเฉพาะทาง) — optional
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  locations                    WarehouseLocation[]
  stockBalances                StockBalance[]
  stockLedgers                 StockLedger[]
  inventoryLots                InventoryLot[]
  goodsReceipts                GoodsReceipt[]
  productionMaterialWarehouses ProductionOrder[]   @relation("ProdMaterialWH")
  productionFgWarehouses       ProductionOrder[]   @relation("ProdFGWH")
  transfersFrom                StockTransfer[]     @relation("TransferFrom")
  transfersTo                  StockTransfer[]     @relation("TransferTo")
  adjustments                  StockAdjustment[]
  purchasePlans                PurchasePlan[]
  purchaseOrders               PurchaseOrder[]

  @@map("warehouses")
}

model WarehouseLocation {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  code        String
  zone        String?
  rack        String?
  bin         String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stockBalances StockBalance[]
  inventoryLots InventoryLot[]

  @@unique([warehouseId, code])
  @@map("warehouse_locations")
}

// ============================================================
// INVENTORY
// ============================================================
model InventoryLot {
  id              String             @id @default(cuid())
  companyId       String
  company         Company            @relation(fields: [companyId], references: [id])
  lotNo           String
  itemId          String
  item            Item               @relation(fields: [itemId], references: [id])
  warehouseId     String?
  warehouse       Warehouse?         @relation(fields: [warehouseId], references: [id])
  locationId      String?
  location        WarehouseLocation? @relation(fields: [locationId], references: [id])
  manufactureDate DateTime?
  receivedDate    DateTime           @default(now())
  expiryDate      DateTime?
  sourceType      String
  sourceReceiptId String?
  sourceReceipt   GoodsReceipt?      @relation("LotSourceReceipt", fields: [sourceReceiptId], references: [id])
  sourceProductionId String?
  sourceProduction ProductionOrder?  @relation("LotSourceProduction", fields: [sourceProductionId], references: [id])
  note            String?
  createdById     String?
  createdAt       DateTime           @default(now())

  stockBalances                 StockBalance[]
  stockLedgers                  StockLedger[]
  receiptItems                  GoodsReceiptItem[]
  productionOutputs             ProductionOutput[]
  issueAllocations              StockIssueLotAllocation[]
  productionMaterialAllocations ProductionMaterialLotAllocation[]
  transferItems                 StockTransferItem[]
  adjustmentItems               StockAdjustmentItem[]

  @@unique([companyId, itemId, lotNo])
  @@index([companyId, expiryDate])
  @@index([sourceReceiptId])
  @@index([sourceProductionId])
  @@map("inventory_lots")
}

model StockBalance {
  id          String             @id @default(cuid())
  itemId      String
  item        Item               @relation(fields: [itemId], references: [id])
  warehouseId String
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id])
  locationId  String?
  location    WarehouseLocation? @relation(fields: [locationId], references: [id])
  lotId       String?
  lot         InventoryLot?      @relation(fields: [lotId], references: [id])
  // MariaDB UNIQUE treats NULL values as distinct. These generated normalized keys
  // make the logical balance identity enforceable without inventing a historical lot.
  locationKey String @default("")
  lotKey      String @default("")

  onHand   Decimal @default(0) @db.Decimal(18, 4)
  reserved Decimal @default(0) @db.Decimal(18, 4)
  // available = onHand - reserved (คำนวณตอนใช้งาน)

  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([itemId, warehouseId, locationKey, lotKey], map: "stock_balances_logical_key")
  @@index([itemId])
  @@index([warehouseId])
  @@map("stock_balances")
}

model StockLedger {
  id           String            @id @default(cuid())
  movementType StockMovementType
  refType      String? // GOODS_RECEIPT | PRODUCTION_ORDER | TRANSFER | ADJUSTMENT ...
  refId        String?
  refNo        String?

  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  locationId  String?
  lotId       String?
  lot         InventoryLot? @relation(fields: [lotId], references: [id])

  qtyIn        Decimal @default(0) @db.Decimal(18, 4)
  qtyOut       Decimal @default(0) @db.Decimal(18, 4)
  // ledger fields เพิ่มเติม (additive, nullable เพื่อไม่กระทบแถวเดิม)
  companyId    String?
  beforeQty    Decimal? @db.Decimal(18, 4)
  unit         String?
  reason       String?
  balanceAfter Decimal @db.Decimal(18, 4)
  unitCost     Decimal @default(0) @db.Decimal(18, 4)
  totalValue   Decimal @default(0) @db.Decimal(18, 4)

  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([itemId, warehouseId, createdAt])
  @@index([movementType])
  @@index([refType, refId])
  @@map("stock_ledgers")
}

// ============================================================
// RECIPE / BOM
// ============================================================
model Recipe {
  id          String    @id @default(cuid())
  companyId   String
  code        String    @unique
  name        String
  productId   String
  product     Item      @relation("RecipeProduct", fields: [productId], references: [id])
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  versions         RecipeVersion[]
  productionOrders ProductionOrder[]
  usedInRecipes    RecipeIngredient[] @relation("SubRecipeChild")

  @@index([productId])
  @@index([companyId, isActive, deletedAt])
  @@map("recipes")
}

model RecipeVersion {
  id        String  @id @default(cuid())
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id])
  versionNo Int
  isActive  Boolean @default(true)

  standardYieldQty Decimal @default(0) @db.Decimal(18, 4) // ผลผลิตมาตรฐาน
  yieldPercent     Decimal @default(100) @db.Decimal(9, 4)
  standardWaste    Decimal @default(0) @db.Decimal(18, 4)

  laborCost    Decimal @default(0) @db.Decimal(18, 4)
  electricCost Decimal @default(0) @db.Decimal(18, 4)
  waterCost    Decimal @default(0) @db.Decimal(18, 4)
  gasCost      Decimal @default(0) @db.Decimal(18, 4)
  overheadCost Decimal @default(0) @db.Decimal(18, 4)
  otherCost    Decimal @default(0) @db.Decimal(18, 4)

  // Recipe Builder 2.0 — yield unit + portion + flexible overhead (all additive/nullable)
  // yieldMode: ACTUAL = รู้ผลผลิตจริง (ต้องมี yieldUnitId) · BATCH = ยังไม่ทราบผลผลิต คิดเป็น 1 Batch
  // null = สูตรเก่าที่ยังไม่ได้เลือกโหมด — ระบบจะให้ผู้ใช้เลือกก่อนใช้เป็นสูตรย่อย (ไม่เดาหน่วยให้)
  yieldMode       String?
  yieldUnitId     String?
  yieldUnit       Unit?    @relation("YieldUnit", fields: [yieldUnitId], references: [id])
  portionQty      Decimal? @db.Decimal(18, 4)
  portionUnit     String?
  overheadMode    String?  // TOTAL | PERCENTAGE | DETAILED
  overheadPercent Decimal? @db.Decimal(9, 4)
  overheadBase    String?  // INGREDIENT | DIRECT | TOTAL
  overheadTotal   Decimal? @db.Decimal(18, 4)
  overheadDetails Json?

  note        String?
  createdAt   DateTime @default(now())
  createdById String?

  ingredients      RecipeIngredient[]
  costs            RecipeCost[]
  productionOrders ProductionOrder[]

  @@unique([recipeId, versionNo])
  @@map("recipe_versions")
}

model RecipeIngredient {
  id              String        @id @default(cuid())
  recipeVersionId String
  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  componentType   String        @default("ITEM") // ITEM | SUB_RECIPE | PACKAGING
  itemId          String?
  item            Item?         @relation(fields: [itemId], references: [id])
  childRecipeId   String?
  childRecipe     Recipe?       @relation("SubRecipeChild", fields: [childRecipeId], references: [id])
  quantity        Decimal       @db.Decimal(18, 4)
  unitId          String?
  unit            Unit?         @relation(fields: [unitId], references: [id])
  wastePercent    Decimal       @default(0) @db.Decimal(9, 4)
  sortOrder       Int           @default(0)
  note            String?

  @@index([recipeVersionId])
  @@index([childRecipeId])
  @@map("recipe_ingredients")
}

model RecipeCost {
  id              String        @id @default(cuid())
  recipeVersionId String
  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)

  materialCost  Decimal  @default(0) @db.Decimal(18, 4)
  packagingCost Decimal  @default(0) @db.Decimal(18, 4)
  laborCost     Decimal  @default(0) @db.Decimal(18, 4)
  utilityCost   Decimal  @default(0) @db.Decimal(18, 4)
  overheadCost  Decimal  @default(0) @db.Decimal(18, 4)
  wasteCost     Decimal  @default(0) @db.Decimal(18, 4)
  totalCost     Decimal  @default(0) @db.Decimal(18, 4)
  unitCost      Decimal  @default(0) @db.Decimal(18, 4)
  costType      String   @default("STANDARD") // STANDARD | ESTIMATED | ACTUAL
  calculatedAt  DateTime @default(now())

  @@index([recipeVersionId])
  @@map("recipe_costs")
}

model SellingPrice {
  id            String   @id @default(cuid())
  companyId     String
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id])
  priceType     String // RETAIL | WHOLESALE | AGENT | SPECIAL
  price         Decimal  @db.Decimal(18, 4)
  markupPercent Decimal? @db.Decimal(9, 4)
  marginPercent Decimal? @db.Decimal(9, 4)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?

  @@unique([itemId, priceType])
  @@map("selling_prices")
}

// ============================================================
// PRODUCTION
// ============================================================
model ProductionOrder {
  id              String         @id @default(cuid())
  companyId       String
  orderNo         String         @unique
  productId       String
  product         Item           @relation(fields: [productId], references: [id])
  recipeId        String?
  recipe          Recipe?        @relation(fields: [recipeId], references: [id])
  recipeVersionId String?
  recipeVersion   RecipeVersion? @relation(fields: [recipeVersionId], references: [id])

  status      ProductionStatus @default(DRAFT)
  plannedQty  Decimal          @default(0) @db.Decimal(18, 4)
  producedQty Decimal          @default(0) @db.Decimal(18, 4)

  materialWarehouseId String?
  materialWarehouse   Warehouse? @relation("ProdMaterialWH", fields: [materialWarehouseId], references: [id])
  fgWarehouseId       String?
  fgWarehouse         Warehouse? @relation("ProdFGWH", fields: [fgWarehouseId], references: [id])

  productionDate DateTime?
  lotNo          String?
  manufactureDate DateTime?
  expiryDate     DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?

  actualCost Decimal @default(0) @db.Decimal(18, 4)
  standardCost   Decimal @default(0) @db.Decimal(18, 4)
  actualUnitCost Decimal @default(0) @db.Decimal(18, 6)
  note           String?
  confirmedAt    DateTime?
  confirmedById  String?
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?

  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  materials ProductionMaterial[]
  outputs   ProductionOutput[]
  wastes    ProductionWaste[]
  sourceLots InventoryLot[] @relation("LotSourceProduction")

  @@index([status])
  @@index([productId])
  @@index([companyId, status])
  @@index([recipeVersionId])
  @@map("production_orders")
}

// ============================================================
// PURCHASE PLANNING — advisory snapshots only; never reserves or moves stock
// ============================================================
model PurchasePlan {
  id          String    @id @default(cuid())
  companyId   String
  planNo      String    @unique
  status      String    @default("DRAFT") // DRAFT | READY | CANCELLED
  planDate    DateTime
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  note        String?
  version     Int       @default(1)
  readyAt     DateTime?
  cancelledAt DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  targets     PurchasePlanTarget[]
  requirements PurchasePlanRequirement[]
  purchaseOrders PurchaseOrder[]

  @@index([companyId, status, planDate])
  @@index([warehouseId])
  @@map("purchase_plans")
}

model PurchasePlanTarget {
  id                String       @id @default(cuid())
  purchasePlanId    String
  purchasePlan      PurchasePlan @relation(fields: [purchasePlanId], references: [id], onDelete: Cascade)
  recipeId          String
  recipeVersionId   String
  productId         String
  recipeCode        String
  recipeName        String
  recipeVersionNo   Int
  productCode       String
  productName       String
  plannedQty        Decimal      @db.Decimal(18, 4)
  yieldMode         String
  outputUnitCode    String

  @@index([purchasePlanId])
  @@map("purchase_plan_targets")
}

model PurchasePlanRequirement {
  id                   String       @id @default(cuid())
  purchasePlanId       String
  purchasePlan         PurchasePlan @relation(fields: [purchasePlanId], references: [id], onDelete: Cascade)
  itemId               String
  itemCode             String
  itemName             String
  categoryId           String?
  categoryName         String?
  requiredQty          Decimal      @db.Decimal(18, 4)
  onHandQty            Decimal      @db.Decimal(18, 4)
  reservedQty          Decimal      @db.Decimal(18, 4)
  availableQty         Decimal      @db.Decimal(18, 4)
  shortageQty          Decimal      @db.Decimal(18, 4)
  baseUnitCode         String
  purchaseUnitCode     String?
  purchaseToBaseFactor Decimal?     @db.Decimal(18, 6)
  purchaseQty          Decimal?     @db.Decimal(18, 4)
  lastBaseUnitPrice    Decimal?     @db.Decimal(18, 4)
  lastPurchasePrice    Decimal?     @db.Decimal(18, 4)
  estimatedCost        Decimal?     @db.Decimal(18, 4)
  latestSupplierId     String?
  latestSupplierName   String?
  selectedSupplierId   String?
  selectedSupplierName String?
  sources              Json
  purchaseOrderItems   PurchaseOrderItem[]

  @@unique([purchasePlanId, itemId])
  @@index([purchasePlanId, shortageQty])
  @@map("purchase_plan_requirements")
}

// Procurement commitment snapshot. Confirming a PO never moves stock or changes item cost.
model PurchaseOrder {
  id                 String              @id @default(cuid())
  companyId          String
  poNo               String              @unique
  status             PurchaseOrderStatus @default(DRAFT)
  orderDate          DateTime
  expectedDeliveryAt DateTime?
  supplierId         String
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId        String
  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id])
  purchasePlanId     String?
  purchasePlan       PurchasePlan?       @relation(fields: [purchasePlanId], references: [id])
  subtotal           Decimal             @default(0) @db.Decimal(18, 4)
  discount           Decimal             @default(0) @db.Decimal(18, 4)
  tax                Decimal             @default(0) @db.Decimal(18, 4)
  grandTotal         Decimal             @default(0) @db.Decimal(18, 4)
  note               String?
  cancellationReason String?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  version            Int                 @default(1)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdById        String?
  updatedById        String?
  items              PurchaseOrderItem[]
  goodsReceipts      GoodsReceipt[]

  @@index([companyId, status, expectedDeliveryAt])
  @@index([supplierId, status])
  @@index([purchasePlanId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                        String                   @id @default(cuid())
  purchaseOrderId           String
  purchaseOrder             PurchaseOrder            @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId                    String
  item                      Item                     @relation(fields: [itemId], references: [id])
  purchasePlanRequirementId String?
  purchasePlanRequirement   PurchasePlanRequirement? @relation(fields: [purchasePlanRequirementId], references: [id])
  itemCode                  String
  itemName                  String
  purchaseUnitId            String?
  purchaseUnitCode          String
  purchaseToBaseFactor      Decimal                  @db.Decimal(18, 6)
  orderedQty                Decimal                  @db.Decimal(18, 4)
  orderedBaseQty            Decimal                  @db.Decimal(18, 4)
  unitPrice                 Decimal                  @db.Decimal(18, 4)
  lineSubtotal              Decimal                  @db.Decimal(18, 4)
  note                      String?
  goodsReceiptItems         GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([purchasePlanRequirementId])
  @@index([itemId])
  @@map("purchase_order_items")
}

model ProductionMaterial {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id])
  plannedQty        Decimal         @default(0) @db.Decimal(18, 4)
  actualQty         Decimal         @default(0) @db.Decimal(18, 4)
  unitCode          String?
  plannedUnitCost   Decimal         @default(0) @db.Decimal(18, 4)
  plannedTotalCost  Decimal         @default(0) @db.Decimal(18, 4)
  unitCost          Decimal         @default(0) @db.Decimal(18, 4)
  totalCost         Decimal         @default(0) @db.Decimal(18, 4)
  lotAllocations    ProductionMaterialLotAllocation[]

  @@index([productionOrderId])
  @@map("production_materials")
}

model ProductionOutput {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id])
  quantity          Decimal         @db.Decimal(18, 4)
  unitCode          String?
  lotNo             String?
  inventoryLotId    String?
  inventoryLot      InventoryLot?   @relation(fields: [inventoryLotId], references: [id])
  manufactureDate   DateTime?
  expiryDate        DateTime?
  unitCost          Decimal         @default(0) @db.Decimal(18, 4)
  createdAt         DateTime        @default(now())

  @@index([productionOrderId])
  @@index([inventoryLotId])
  @@map("production_outputs")
}

model ProductionWaste {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  itemId            String?
  item              Item?           @relation(fields: [itemId], references: [id])
  quantity          Decimal         @db.Decimal(18, 4)
  unitCode          String?
  reason            String
  note              String?
  unitCost          Decimal?        @db.Decimal(18, 4)
  totalCost         Decimal?        @db.Decimal(18, 4)
  recordedById      String?
  recordedAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())

  @@index([productionOrderId])
  @@map("production_wastes")
}

// ============================================================
// GOODS RECEIPT
// ============================================================
model GoodsReceipt {
  id          String         @id @default(cuid())
  companyId   String
  receiptNo   String         @unique
  supplierId  String?
  supplier    Supplier?      @relation(fields: [supplierId], references: [id])
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  status      DocumentStatus @default(DRAFT)
  receiptDate DateTime       @default(now())
  note        String?
  // additive/nullable — เอกสารฝั่งผู้ขายและเวลาเปลี่ยนสถานะ
  supplierDocNo String?
  /// PHASE 35 — เหตุผลการรับเข้า: PURCHASE | OPENING | ADJUST | OTHER
  /// เก็บเป็น String? แบบเดียวกับ StockAdjustment.reason เพื่อไม่ต้องแก้ enum ของ movement
  /// ว่างไว้ = ใบรับของเดิมก่อนมีฟิลด์นี้ (ตีความเป็น PURCHASE ตอนแสดงผล ไม่เขียนทับข้อมูลเดิม)
  receiveReason String?
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  confirmedAt   DateTime?
  reversedAt    DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  items       GoodsReceiptItem[]
  attachments GoodsReceiptAttachment[]
  extractions GoodsReceiptExtraction[]
  sourceLots  InventoryLot[] @relation("LotSourceReceipt")

  @@index([status])
  @@index([purchaseOrderId, status])
  @@map("goods_receipts")
}

/**
 * PHASE 22 — ไฟล์เอกสารต้นฉบับจากผู้ขายที่แนบมากับใบรับของ
 *
 * เป็นหลักฐานประกอบเท่านั้น ไม่ใช่แหล่งความจริงของรายการรับของ
 * ใบรับของยังทำงานได้ครบถ้วนเหมือนเดิมเมื่อไม่มีไฟล์แนบ (ตารางนี้เป็นส่วนเพิ่มล้วน)
 * เก็บเฉพาะ metadata ตัวไฟล์อยู่บนดิสก์ ไม่เก็บ binary ลงฐานข้อมูล
 */
model GoodsReceiptAttachment {
  id             String       @id @default(cuid())
  companyId      String
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  originalName   String
  storedName     String       @unique
  mimeType       String
  sizeBytes      Int
  uploadedAt     DateTime     @default(now())
  uploadedById   String?
  extractions    GoodsReceiptExtraction[]

  @@index([goodsReceiptId])
  @@map("goods_receipt_attachments")
}

/**
 * PHASE 23 — ผลอ่านเอกสารเป็นชั้นกลางสำหรับให้มนุษย์ตรวจทาน
 * ห้ามถือเป็นข้อมูลรับเข้าจริงจนกว่าจะ apply ไปยัง GoodsReceipt DRAFT อย่างชัดเจน
 */
model GoodsReceiptExtraction {
  id                     String                 @id @default(cuid())
  companyId              String
  goodsReceiptId         String
  goodsReceipt           GoodsReceipt           @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  attachmentId           String
  attachment             GoodsReceiptAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  version                Int
  status                 String                 @default("PENDING")
  quality                String?
  supplierName           String?
  supplierTaxId          String?
  supplierDocumentNo     String?
  documentDate           DateTime?
  currency               String?
  matchedSupplierId      String?
  matchedSupplier        Supplier?              @relation("ExtractionMatchedSupplier", fields: [matchedSupplierId], references: [id])
  subtotal               Decimal?               @db.Decimal(18, 4)
  discount               Decimal?               @db.Decimal(18, 4)
  vat                    Decimal?               @db.Decimal(18, 4)
  grandTotal             Decimal?               @db.Decimal(18, 4)
  warnings               Json?
  rawText                 String?                @db.LongText
  failureCode             String?
  failureMessage          String?
  sourceReceiptUpdatedAt  DateTime
  extractedAt             DateTime?
  appliedAt               DateTime?
  createdById             String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  lines                   GoodsReceiptExtractionLine[]

  @@unique([attachmentId, version])
  @@index([goodsReceiptId, createdAt])
  @@index([companyId, status])
  @@map("goods_receipt_extractions")
}

model GoodsReceiptExtractionLine {
  id                 String                 @id @default(cuid())
  extractionId       String
  extraction         GoodsReceiptExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  position           Int
  rawDescription     String
  extractedItemCode  String?
  quantity           Decimal?               @db.Decimal(18, 4)
  unitText            String?
  unitPrice           Decimal?               @db.Decimal(18, 4)
  lineTotal           Decimal?               @db.Decimal(18, 4)
  matchedItemId       String?
  matchedItem         Item?                  @relation("ExtractionMatchedItem", fields: [matchedItemId], references: [id])
  matchedUnitId       String?
  matchedUnit         Unit?                  @relation("ExtractionMatchedUnit", fields: [matchedUnitId], references: [id])
  matchStatus         String                 @default("UNMATCHED")
  warnings            Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([extractionId, position])
  @@index([matchedItemId])
  @@map("goods_receipt_extraction_lines")
}

model GoodsReceiptItem {
  id              String       @id @default(cuid())
  goodsReceiptId  String
  goodsReceipt    GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item         @relation(fields: [itemId], references: [id])
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  lotNo           String?
  inventoryLotId  String?
  inventoryLot    InventoryLot? @relation(fields: [inventoryLotId], references: [id])
  manufactureDate DateTime?
  expiryDate      DateTime?
  quantity        Decimal      @db.Decimal(18, 4)
  purchaseUnitCode String?
  purchaseToBaseFactor Decimal? @db.Decimal(18, 6)
  unitPrice       Decimal      @db.Decimal(18, 4)
  discount        Decimal      @default(0) @db.Decimal(18, 4)
  taxAmount       Decimal      @default(0) @db.Decimal(18, 4)
  extraCost       Decimal      @default(0) @db.Decimal(18, 4)
  totalCost       Decimal      @default(0) @db.Decimal(18, 4)
  /// PHASE 35 — หมายเหตุระดับบรรทัด (Remark ของผู้ใช้) เช่น "หมูจากตลาดเช้า ราคาขึ้น"
  /// เป็นหลักฐานประกอบของบรรทัดนั้น ไม่ใช่แหล่งความจริงของจำนวน/ราคา
  note            String?      @db.Text

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([inventoryLotId])
  @@map("goods_receipt_items")
}

// ============================================================
// TRANSFER / ADJUSTMENT
// ============================================================
model StockTransfer {
  id              String         @id @default(cuid())
  companyId       String
  transferNo      String         @unique
  fromWarehouseId String
  fromWarehouse   Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  status          DocumentStatus @default(DRAFT)
  transferDate    DateTime       @default(now())
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdById     String?

  items StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id              String        @id @default(cuid())
  stockTransferId String
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id])
  lotNo           String?
  lotId           String?
  lot             InventoryLot? @relation(fields: [lotId], references: [id])
  quantity        Decimal       @db.Decimal(18, 4)

  @@index([stockTransferId])
  @@index([lotId])
  @@map("stock_transfer_items")
}

model StockAdjustment {
  id             String         @id @default(cuid())
  companyId      String
  adjustmentNo   String         @unique
  warehouseId    String
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  status         DocumentStatus @default(DRAFT)
  reason         String?
  adjustmentDate DateTime       @default(now())
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?

  items StockAdjustmentItem[]

  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id                String          @id @default(cuid())
  stockAdjustmentId String
  stockAdjustment   StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id])
  lotNo             String?
  lotId              String?
  lot                InventoryLot? @relation(fields: [lotId], references: [id])
  systemQty         Decimal         @default(0) @db.Decimal(18, 4)
  countedQty        Decimal         @default(0) @db.Decimal(18, 4)
  diffQty           Decimal         @default(0) @db.Decimal(18, 4)

  @@index([stockAdjustmentId])
  @@index([lotId])
  @@map("stock_adjustment_items")
}

// ============================================================
// SYSTEM
// ============================================================
model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("system_settings")
}

model Customer {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id])
  code         String
  name         String
  customerType String?
  contactName  String?
  phone        String?
  email        String?
  address      String? // ที่อยู่จัดส่ง
  billingAddress String? // ที่อยู่ออกใบกำกับภาษี (ถ้าต่างจากที่อยู่จัดส่ง)
  lineId       String?
  branch       String? // สาขา / แผนก
  taxId        String?
  note         String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  orders       SalesOrder[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("customers")
}

model SalesOrder {
  id                 String           @id @default(cuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  orderNo            String
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id])
  contactName        String?
  phone              String?
  email              String?
  deliveryAddress    String?
  deliveryDate       DateTime
  deliveryTime       String?
  status             SalesOrderStatus @default(DRAFT)
  subtotal           Decimal          @default(0) @db.Decimal(18, 4)
  discount           Decimal          @default(0) @db.Decimal(18, 4)
  tax                Decimal          @default(0) @db.Decimal(18, 4)
  totalAmount        Decimal          @default(0) @db.Decimal(18, 4)
  // ระดับราคาที่ใช้ "ตั้งต้น" ราคาของออเดอร์นี้ (RETAIL | WHOLESALE | AGENT | SPECIAL)
  // เก็บเป็น String ให้ตรงกับวิธีเก็บของ SellingPrice.priceType ที่มีอยู่แล้ว ไม่สร้าง enum ซ้อน
  // nullable เพราะออเดอร์เก่าไม่มีข้อมูลนี้ — ห้าม backfill เดา
  // หมายเหตุสำคัญ: ความจริงทางการเงินของออเดอร์คือ SalesOrderItem.unitPrice / lineTotal
  // priceTier เป็นเพียง metadata ว่าราคาเริ่มมาจากระดับไหน
  priceTier          String?
  note               String?
  createdByUserId    String
  createdBy          User             @relation("SalesOrderCreator", fields: [createdByUserId], references: [id])
  sentToOperationsAt DateTime?
  confirmedAt        DateTime?
  issuedAt           DateTime?
  readyAt            DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  idempotencyKey     String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  items              SalesOrderItem[]
  stockIssues        StockIssue[]

  @@unique([companyId, orderNo])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, status, deliveryDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id               String     @id @default(cuid())
  orderId          String
  order            SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuId           String
  menuNameSnapshot String
  quantity         Decimal    @db.Decimal(18, 4)
  unit             String
  unitPrice        Decimal    @db.Decimal(18, 4)
  lineTotal        Decimal    @db.Decimal(18, 4)
  note             String?

  @@index([orderId])
  @@map("sales_order_items")
}

model StockIssue {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  issueNo         String
  orderId         String?
  order           SalesOrder?      @relation(fields: [orderId], references: [id])
  warehouseId     String
  issueDate       DateTime         @default(now())
  destination     String           @default("CENTRAL_KITCHEN")
  status          StockIssueStatus @default(DRAFT)
  note            String?
  createdByUserId String
  createdBy       User             @relation("StockIssueCreator", fields: [createdByUserId], references: [id])
  issuedAt        DateTime?
  idempotencyKey  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           StockIssueItem[]

  @@unique([companyId, issueNo])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, status])
  @@map("stock_issues")
}

model StockIssueItem {
  id           String     @id @default(cuid())
  stockIssueId String
  stockIssue   StockIssue @relation(fields: [stockIssueId], references: [id], onDelete: Cascade)
  itemId       String
  requiredQty  Decimal    @default(0) @db.Decimal(18, 4)
  issuedQty    Decimal    @db.Decimal(18, 4)
  unit         String
  baseQty      Decimal    @db.Decimal(18, 4)
  note         String?
  lotAllocations StockIssueLotAllocation[]

  @@index([stockIssueId])
  @@map("stock_issue_items")
}

model StockIssueLotAllocation {
  id               String         @id @default(cuid())
  stockIssueItemId String
  stockIssueItem   StockIssueItem @relation(fields: [stockIssueItemId], references: [id], onDelete: Cascade)
  lotId            String
  lot              InventoryLot   @relation(fields: [lotId], references: [id])
  quantity         Decimal        @db.Decimal(18, 4)
  createdAt        DateTime       @default(now())

  @@unique([stockIssueItemId, lotId], map: "issue_lot_alloc_unique")
  @@index([lotId])
  @@map("stock_issue_lot_allocations")
}

model ProductionMaterialLotAllocation {
  id                   String             @id @default(cuid())
  productionMaterialId String
  productionMaterial   ProductionMaterial @relation(fields: [productionMaterialId], references: [id], onDelete: Cascade)
  lotId                String             
  lot                  InventoryLot       @relation(fields: [lotId], references: [id])
  quantity             Decimal            @db.Decimal(18, 4)
  createdAt            DateTime           @default(now())

  @@unique([productionMaterialId, lotId], map: "prod_mat_lot_alloc_unique")
  @@index([lotId])
  @@map("production_material_lot_allocations")
}

model Notification {
  id         String               @id @default(cuid())
  companyId  String
  company    Company              @relation(fields: [companyId], references: [id])
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  severity   NotificationSeverity @default(INFO)
  title      String
  message    String
  entityType String?
  entityId   String?
  actionUrl  String?
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  @@index([companyId, userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String
  eventType String
  enabled   Boolean @default(true)

  @@unique([companyId, userId, channel, eventType])
  @@map("notification_preferences")
}

model InventoryValuationSnapshot {
  id                      String   @id @default(cuid())
  companyId               String
  snapshotAt              DateTime @default(now())
  businessDate            DateTime @db.Date
  source                  String
  knownInventoryValue     Decimal  @db.Decimal(20, 4)
  knownBalanceCount       Int
  unknownCostBalanceCount Int
  negativeStockCount      Int
  valuationCompleteness   Decimal  @db.Decimal(9, 4)
  createdAt               DateTime @default(now())
  createdById             String?
  lines                   InventoryValuationSnapshotLine[]

  @@unique([companyId, businessDate], map: "valuation_snapshot_company_date")
  @@index([companyId, snapshotAt])
  @@map("inventory_valuation_snapshots")
}

model InventoryValuationSnapshotLine {
  id                 String                     @id @default(cuid())
  snapshotId         String
  snapshot           InventoryValuationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  itemId             String
  itemCode           String
  itemName           String
  warehouseId        String
  warehouseCode      String
  warehouseName      String
  lotId              String?
  lotNo              String?
  locationId         String?
  onHand             Decimal                    @db.Decimal(18, 4)
  reserved           Decimal                    @db.Decimal(18, 4)
  baseUnitId         String
  baseUnitCode       String
  recognizedUnitCost Decimal?                   @db.Decimal(18, 6)
  costStatus         String
  estimatedValue     Decimal?                   @db.Decimal(20, 4)
  costSource         String
  itemType           String
  categoryId         String?
  categoryName       String?
  expiryDate         DateTime?
  expiryStatus       String?
  daysRemaining      Int?
  createdAt          DateTime                   @default(now())

  @@index([snapshotId, warehouseId])
  @@index([snapshotId, itemType])
  @@index([snapshotId, itemId])
  @@map("inventory_valuation_snapshot_lines")
}

// ============================================================
// INVENTORY LEDGER + DOCUMENT NUMBERING (additive)
// ============================================================


/// บัญชีการเคลื่อนไหวสต็อก — ทุกการเปลี่ยน onHand ต้องมีแถวที่นี่เสมอ (ตรวจย้อนหลังได้)
/// ห้ามลบแถวเดิม การยกเลิกทำด้วย REVERSAL ที่อ้าง sourceId เดิม

/// ตัวนับเลขเอกสารต่อบริษัท/ชนิด/ช่วงเวลา — backend เท่านั้นที่ออกเลข
model DocumentCounter {
  id        String   @id @default(cuid())
  companyId String
  docType   String // STOCK_ISSUE | GOODS_RECEIPT | STOCK_ADJUSTMENT
  periodKey String // YYYYMMDD
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([companyId, docType, periodKey])
  @@map("document_counters")
}
