PORT=1415

# ── Database access (PostgreSQL รับเฉพาะ localhost:5432 เท่านั้น) ──
# Runtime: บัญชีสิทธิ์จำกัด s2a_app (SELECT/INSERT/UPDATE/DELETE) — ห้ามใช้ postgres
DATABASE_URL=postgresql://s2a_app:change-me@localhost:5432/food_erp
# Integration test database
TEST_DATABASE_URL=postgresql://s2a_app:change-me@localhost:5432/food_erp_test
# Migration/introspection เท่านั้น: บัญชี owner/postgres (อย่าใส่ให้ frontend/runtime)
DIRECT_URL=postgresql://postgres:change-me@localhost:5432/food_erp

JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:1414
NODE_ENV=development
LOG_LEVEL=info

# Google Sheets (อ่านอย่างเดียว, ปิดโดยค่าเริ่มต้น)
GOOGLE_SHEETS_READ_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_REFERENCE_SHEET_ID=

# Optional notification channels (the application remains operational when disabled)
LINE_MESSAGING_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=S2 Accounting Consultant
MAIL_FROM_EMAIL=
