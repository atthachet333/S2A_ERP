PORT=1415

# ── Database access (MariaDB; Prisma uses the mysql:// URL scheme) ──
# Runtime: บัญชีสิทธิ์จำกัด s2a_user สำหรับฐานข้อมูล s2a_erp
DATABASE_URL=mysql://s2a_user:change-me@localhost:3306/s2a_erp
# Integration test database
TEST_DATABASE_URL=mysql://s2a_user:change-me@localhost:3306/s2a_erp_test
# Migration/introspection เท่านั้น: บัญชี DDL ที่จำกัดสิทธิ์กับฐานข้อมูลนี้
DIRECT_URL=mysql://s2a_user:change-me@localhost:3306/s2a_erp

JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:1414
NODE_ENV=development
LOG_LEVEL=info

# Google Sheets (อ่านอย่างเดียว, ปิดโดยค่าเริ่มต้น)
GOOGLE_SHEETS_READ_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_REFERENCE_SHEET_ID=

# Optional notification channels (the application remains operational when disabled)
LINE_MESSAGING_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=S2 Accounting Consultant
MAIL_FROM_EMAIL=
