# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment (never commit real secrets)
.env
.env.*
!.env.example
.env.local
.env.*.local
backend/.env
frontend/.env

# Prisma
backend/prisma/*.db
backend/prisma/migrations/dev.db*

